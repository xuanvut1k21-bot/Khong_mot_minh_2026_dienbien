DATABASE_URL=postgresql://user:password@localhost:5432/khongmotminh
# Do not copy these placeholders into production. All are required for admin login.
APP_BASE_URL=https://campaign.example.vn
OIDC_ISSUER=https://identity.example.vn/realms/km
OIDC_CLIENT_ID=CONFIGURE_IDP_CLIENT_ID
OIDC_CLIENT_SECRET=CONFIGURE_PRIVATE_CLIENT_SECRET
OIDC_AUTHORIZATION_ENDPOINT=https://identity.example.vn/realms/km/protocol/openid-connect/auth
OIDC_TOKEN_ENDPOINT=https://identity.example.vn/realms/km/protocol/openid-connect/token
OIDC_JWKS_URI=https://identity.example.vn/realms/km/protocol/openid-connect/certs
OIDC_REQUIRED_ACR=CONFIGURE_REAL_MFA_ASSURANCE_CLASS
ADMIN_STATE_KEY_BASE64=GENERATE_32_RANDOM_BYTES_BASE64

# Image uploads are disabled until private S3 storage, IAM, CORS and ClamAV are ready.
MEDIA_IMAGE_UPLOADS_ENABLED=false
AWS_REGION=ap-southeast-1
MEDIA_QUARANTINE_BUCKET=PRIVATE_QUARANTINE_BUCKET
MEDIA_PROCESSED_BUCKET=PRIVATE_PROCESSED_BUCKET
