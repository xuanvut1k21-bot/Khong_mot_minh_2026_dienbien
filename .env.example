DATABASE_URL=postgresql://user:password@localhost:5432/khongmotminh
# Local development only; replace placeholders in a private environment.
APP_BASE_URL=http://localhost:3000
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=CONFIGURE_GOOGLE_OAUTH_CLIENT_ID
OIDC_CLIENT_SECRET=CONFIGURE_PRIVATE_GOOGLE_CLIENT_SECRET
OIDC_AUTHORIZATION_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth
OIDC_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
OIDC_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
ADMIN_STATE_KEY_BASE64=GENERATE_32_RANDOM_BYTES_BASE64

# One-time first-admin bootstrap: exact verified Google account email; remove after bootstrap.
BOOTSTRAP_ADMIN_EMAIL=your-authorized-gmail@example.com

# Image uploads are disabled until private S3 storage, IAM, CORS and ClamAV are ready.
MEDIA_IMAGE_UPLOADS_ENABLED=false
AWS_REGION=ap-southeast-1
MEDIA_QUARANTINE_BUCKET=PRIVATE_QUARANTINE_BUCKET
MEDIA_PROCESSED_BUCKET=PRIVATE_PROCESSED_BUCKET

# Both disabled until sandboxed workers and updated Poppler/FFmpeg/ClamAV are tested.
MEDIA_PDF_PREVIEW_ENABLED=false
MEDIA_VIDEO_POSTER_ENABLED=false

# Training registration and official examination are CLOSED by default.
# Configure HTTPS privacy notice, anti-abuse, retention and verified survey provider first.
TRAINING_REGISTRATION_ENABLED=false
TRAINING_EXAM_ENABLED=false
TRAINING_PRIVACY_NOTICE_URL=
TRAINING_SURVEY_WEBHOOK_ENABLED=false
TRAINING_SURVEY_WEBHOOK_SECRET=

# Off by default: requires a real survey provider with signed server-to-server callbacks.
TRAINING_SURVEY_LAUNCH_ENABLED=false
TRAINING_SURVEY_PROVIDER_HOST=
TRAINING_SURVEY_1_URL=
TRAINING_SURVEY_9_URL=

# Production guard requires verified ingress bot/rate-limit protection.
# Setting true ONLY acknowledges independent infrastructure is configured.
TRAINING_EDGE_RATE_LIMIT_READY=false
# Maintenance is DRY RUN by default. Approve a lawful retention policy first.
TRAINING_RETENTION_PURGE_ENABLED=false
TRAINING_LEARNER_RETENTION_DAYS=180

# Only for read-only staging preflight, not a deployment command.
STAGING_DEPLOYMENT_TARGET=
